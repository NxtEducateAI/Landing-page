# ========================================================
# NXTEducate AI - Email Notification Configuration (SMTP)
# ========================================================

# The email address that will RECEIVE all submitted demo request forms
RECIPIENT_EMAIL=info.nxteducateai@gmail.com

# SMTP Server Configuration (Example: Gmail SMTP)
# If using Gmail:
# 1. Turn on 2-Step Verification in your Google Account
# 2. Go to Security -> 2-Step Verification -> App Passwords
# 3. Create an App password (16 letters) and paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password_here

# Optional: Custom From Name/Address
SMTP_FROM="NxtEducate AI" <info.nxteducateai@gmail.com> 
